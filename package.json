{
  "name": "2fa-authenticate",
  "version": "1.0.5",
  "description": "",
  "main": "index.js",
  "bin": "dist/2fa-authenticate.js",
  "scripts": {
    "start:gen": "npx nodemon -- gen",
    "start:verify": "npx nodemon -- verify",
    "start:qrcode": "npx nodemon -- qrcode --name POSOD",
    "start:wrong": "npx nodemon -- ",
    "start:helpGen": "npx nodemon -- help gen",
    "start:helpVerify": "npx nodemon -- help verify",
    "build": "node -e \"require('node:fs').rmSync('./dist', { recursive: true, force: true })\" && tsc",
    "start": "npm run build && node dist/2fa-authenticate.js",
    "pkg": "npm run build && npx --yes --package=@yao-pkg/pkg pkg ."
  },
  "pkg": {
    "targets": [
      "node24-win-x64",
      "node24-linux-x64"
    ],
    "outputPath": "package"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^11.0.0",
    "nodemon": "^3.1.14",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.6.2",
    "@types/qrcode": "^1.5.2",
    "@types/speakeasy": "^2.0.7",
    "@yao-pkg/pkg": "^6.24.0"
  }
}
